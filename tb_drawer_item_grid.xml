<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/entry"
    android:layout_width="@dimen/tb_start_menu_grid_width"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/tb_start_menu_grid_padding"
    android:paddingTop="4dp"
    android:paddingRight="@dimen/tb_start_menu_grid_padding"
    android:paddingBottom="6dp"
    android:orientation="vertical"
    android:background="@drawable/tb_drawer_item_bg">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="8dp"
        android:layout_gravity="center_horizontal"
        tools:src="@drawable/tb_allapps_pressed" />

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?tb_drawer_on_surface"
        android:textSize="@dimen/tb_start_menu_grid_text_size"
        tools:text="@string/tb_app_name" />

</LinearLayout>
