<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?tb_drawer_state_layer">
    <item android:id="@android:id/mask">
        <inset android:inset="@dimen/tb_drawer_item_inset">
            <shape android:shape="rectangle">
                <solid android:color="#000000" />
                <corners android:radius="@dimen/tb_drawer_item_radius" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="@dimen/tb_drawer_item_inset">
            <selector>
                <!-- keyboard focus / arrow-key selection: state layer plus a 2dp ring -->
                <item android:state_focused="true">
                    <shape android:shape="rectangle">
                        <solid android:color="?tb_drawer_hover" />
                        <stroke android:width="2dp" android:color="?tb_drawer_on_surface_variant" />
                        <corners android:radius="@dimen/tb_drawer_item_radius" />
                    </shape>
                </item>
                <item android:state_selected="true">
                    <shape android:shape="rectangle">
                        <solid android:color="?tb_drawer_hover" />
                        <stroke android:width="2dp" android:color="?tb_drawer_on_surface_variant" />
                        <corners android:radius="@dimen/tb_drawer_item_radius" />
                    </shape>
                </item>
                <item android:state_hovered="true">
                    <shape android:shape="rectangle">
                        <solid android:color="?tb_drawer_hover" />
                        <corners android:radius="@dimen/tb_drawer_item_radius" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@android:color/transparent" />
                    </shape>
                </item>
            </selector>
        </inset>
    </item>
</ripple>
